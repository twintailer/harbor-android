// Adds two things the stock Tauri activity lacks:
//  1. Immersive full screen - the status bar and (on tablets especially) the
//     navigation/task bar stay hidden; a swipe from the edge reveals them
//     transiently. Content draws edge-to-edge, including under a display
//     cutout, which the web UI already pads for via env(safe-area-inset-*).
//  2. Android-native back: the system back gesture/button walks the web app's
//     own view stack instead of quitting. The activity asks the page
//     (window.__harborAndroidBack, defined in App.tsx) whether it consumed the
//     press, and only backgrounds the app when nothing is left to pop.
package __PACKAGE__

__IMPORTS__
import android.os.Build
import android.os.Bundle
import android.view.View
import android.view.ViewGroup
import android.webkit.WebView

class MainActivity : __BASE__() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            window.attributes = window.attributes.apply {
                layoutInDisplayCutoutMode =
                    android.view.WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
            }
        }
        applyImmersive()
    }

    override fun onWindowFocusChanged(hasFocus: Boolean) {
        super.onWindowFocusChanged(hasFocus)
        // Bars come back after a reveal swipe or a trip to recents/the shade;
        // re-hide them whenever we regain focus.
        if (hasFocus) applyImmersive()
    }

    @Suppress("DEPRECATION")
    private fun applyImmersive() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            window.setDecorFitsSystemWindows(false)
            window.insetsController?.let { c ->
                c.hide(android.view.WindowInsets.Type.systemBars())
                c.systemBarsBehavior =
                    android.view.WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
            }
        } else {
            window.decorView.systemUiVisibility = (
                View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
                    or View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                    or View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                    or View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                    or View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                    or View.SYSTEM_UI_FLAG_FULLSCREEN
                )
        }
    }

    private fun findWebView(v: View = window.decorView): WebView? {
        if (v is WebView) return v
        if (v is ViewGroup) {
            for (i in 0 until v.childCount) {
                findWebView(v.getChildAt(i))?.let { return it }
            }
        }
        return null
    }

    /** Leave the app the way the system would: keep it warm in the background. */
    private fun leaveApp() {
        moveTaskToBack(true)
    }

    @Suppress("DEPRECATION", "MissingSuperCall")
    override fun onBackPressed() {
        val wv = findWebView()
        if (wv == null) {
            leaveApp()
            return
        }
        // The web app pops its own stack / closes an overlay and answers "1".
        // Anything else means there is nothing left to go back to.
        val js =
            "(function(){try{return window.__harborAndroidBack&&window.__harborAndroidBack()?'1':'0'}" +
                "catch(e){return '0'}})()"
        wv.evaluateJavascript(js) { result ->
            val handled = result != null && result.replace("\"", "").trim() == "1"
            if (!handled) runOnUiThread { leaveApp() }
        }
    }
